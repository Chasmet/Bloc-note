<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#130C09</item>
        <item name="android:statusBarColor">#130C09</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#D7832B</item>
        <item name="android:windowBackground">#130C09</item>
    </style>
    <style name="AppTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">#F4F6FF</item>
        <item name="android:statusBarColor">#F4F6FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#A35B1D</item>
        <item name="android:windowBackground">#F4F6FF</item>
    </style>
</resources>
